# Bot token: App → OAuth & Permissions → Bot User OAuth Token (starts with xoxb-).
JOURNALING_SLACK_BOT_TOKEN=xoxb-your-token

# Default channel for post_slack_message.py when you omit --channel.
JOURNALING_SLACK_CHANNEL_ID=C0123456789

# Your Slack member ID (starts with U). Used only with --prepend-user-mention.
JOURNALING_SLACK_USER_ID=U0123456789
