# Copy to .env in this repo root. Never commit .env.
#
# Bot token: App → OAuth & Permissions → Bot User OAuth Token (starts with xoxb-).
# You may use JOURNALING_SLACK_BOT_TOKEN or any SLACK_* name (see script_utils).
JOURNALING_SLACK_BOT_TOKEN=xoxb-your-token

# Default channel for post_slack_message.py when you omit --channel.
# Find ID: channel menu → copy link, or channel details.
JOURNALING_SLACK_CHANNEL_ID=C0123456789

# Your Slack member ID (starts with U). Used for:
# - post_slack_message.py --prepend-user-mention
# - generate_manager_report.py --report-audience self --format slack (prepends <@YOU>)
# Find: Profile → … → Copy member ID (wording varies).
JOURNALING_SLACK_USER_ID=U0123456789

# Before first post: invite the bot to the channel; OAuth scope chat:write (see journaling README).
