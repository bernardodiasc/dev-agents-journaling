# Copy to .env in the repo root (or $JOURNALING_HOME) and `chmod 600 .env`. Never commit .env.

# Slack bot token (required to post or fetch). Scopes: chat:write, channels:history, groups:history
JOURNALING_SLACK_BOT_TOKEN=xoxb-your-token

# "My channel" — default target for "post status update"
JOURNALING_SLACK_CHANNEL_ID=C0123456789

# Your Slack member ID (optional; enables <@you> mentions)
# JOURNALING_SLACK_USER_ID=U0123456789

# Named channel aliases (optional) — any JOURNALING_SLACK_CHANNEL_ID_<NAME> works,
# referenced as "post to team" / --channel-name team
# JOURNALING_SLACK_CHANNEL_ID_TEAM=C0123456780

# Limit GitHub activity in status updates to these orgs/users (optional, comma-separated)
# JOURNALING_GITHUB_OWNERS=my-org

# Jira base URL (optional) — only used to validate pasted Atlassian links
# JOURNALING_JIRA_BASE_URL=https://your-org.atlassian.net
