# Slack bot token (required for fetch/post)
JOURNALING_SLACK_BOT_TOKEN=xoxb-your-token

# Default Slack channel ID (used when no --channel / --channel-name is passed)
JOURNALING_SLACK_CHANNEL_ID=C0123456789

# Your Slack member ID (enables <@you> mentions on self reports / --prepend-user-mention)
JOURNALING_SLACK_USER_ID=U0123456789

# Named channel aliases (optional) — any JOURNALING_SLACK_CHANNEL_ID_<NAME> works.
# Reference at the CLI with --channel-name dev-qa / team / self / project_dev / etc.
# Report-type hints (SELF / TEAM / MANAGER / QA) let the agent match audience → channel.
# JOURNALING_SLACK_CHANNEL_ID_SELF=C01111AAAAA
# JOURNALING_SLACK_CHANNEL_ID_TEAM=C02222BBBBB
# JOURNALING_SLACK_CHANNEL_ID_DEV_QA=C03333CCCCC
# JOURNALING_SLACK_CHANNEL_ID_PROJECT_DEV=C04444DDDDD

# Jira base URL (optional) — only used to validate pasted ticket/epic/project URLs
# JOURNALING_JIRA_BASE_URL=https://project.atlassian.net
